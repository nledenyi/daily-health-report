# daily-health-report configuration
# Sourced by /usr/local/bin/daily-health-report at startup.
# Install this file to /etc/daily-health/config (mode 0644) and edit as needed.

# ===== Identity =====
# PVE node name — used to find /etc/pve/nodes/<name>/qemu-server/ and lxc/ configs.
# Default to `hostname`; override if your PVE node name differs.
PVE_NODE="${PVE_NODE:-$(hostname)}"

# Output directory for the appended markdown log. The directory is created if missing.
LOG_DIR="/var/log/daily-health"

# Email "From:" header. Must match your postfix/msmtp sender config.
MAIL_FROM="Proxmox <root@$(hostname -f 2>/dev/null || hostname)>"

# ===== Service endpoints =====
# Home Assistant API (leave empty to skip). Expected 200/401/403.
HA_URL="http://192.168.1.10:8123/api/"
HA_TOKEN=""                                           # Long-Lived Access Token — enables Assist conversation-agent health check
HA_ASSIST_ENTITY="conversation.ollama_conversation"   # entity to verify is not 'unavailable'
HA_LLM_DOMAIN="ollama"                                # config-entry domain of the conversation backend

# vLLM (leave VLLM_API empty to skip the whole vLLM/proxy section)
VLLM_API="http://192.168.1.20:8000"
VLLM_LXC=106                      # LXC hosting the vLLM systemd unit
VLLM_UNIT="vllm-qwen38"           # unit name, used for the boot-log kernel check
VLLM_MAXLEN_EXPECTED=204800       # warn if the served context silently shrinks

# LLM proxy in front of vLLM (LiteLLM). Every consumer routes through this,
# so it is checked separately from the model server.
PROXY_API="http://192.168.1.20:4000"
PROXY_KEY=""                      # proxy master/virtual key
PROXY_PROBE_MODEL="voice"         # alias used for the daily TTFT latency probe

# Ollama (leave OLLAMA_API empty to skip the entire Ollama section)
OLLAMA_API="http://192.168.1.20:11434"
OLLAMA_METRICS="http://192.168.1.20:11435/metrics"   # optional prometheus proxy
# Optional hook script that upgrades Ollama in place (called with the target
# version as $1). If set and executable, patch-level updates (x.y.A -> x.y.B)
# are applied silently and reported as INFO; minor/major bumps always WARN.
# Empty = every update WARNs (no auto-upgrade).
OLLAMA_UPGRADE_HOOK=""

# Syncthing — set to "" to skip. API key is read from the config XML at runtime.
SYNCTHING_URL=""                                      # e.g. http://192.168.1.30:8384
SYNCTHING_CONFIG_XML="/var/lib/syncthing/config.xml"
SYNCTHING_IGNORE_PEERS=""                             # comma-separated peer names to skip offline alerts for, e.g. "samsung-phone,old-laptop"

# ===== Storage =====
# Regex of ZFS pool names whose datasets should be sanoid-coverage checked.
# Pools not matching this are skipped (typically rpool, backup-only pools, etc.).
ZFS_POOLS_REGEX="(rpool|tank)"

# Dataset replicated by syncoid. Empty = skip syncoid-replication age check.
SYNCOID_DATASET="tank/important"
# systemd unit for the syncoid replication run (checked for last exit status).
# Empty = skip the service-status row (still shows as OK/neutral).
SYNCOID_SERVICE="syncoid.service"
# Human label for the replication row in the report. Empty = use SYNCOID_DATASET.
SYNCOID_LABEL=""                                     # e.g. "tank/important -> backup"

# vzdump backup log glob. Default is the standard PVE location.
VZDUMP_LOG_GLOB="/var/lib/vz/dump/*.log"

# WARN if a guest covered by an enabled vzdump job has no backup newer than
# this many hours on the job's storage (catches silently-skipped guests when
# the per-job email is disabled). 0 or empty = skip the freshness check.
VZDUMP_MAX_AGE_H=192    # 8 days, for a weekly schedule

# Custom file-freshness checks for cron/timer backups whose only signal is a
# sentinel or dump file. Each entry: "Label|path_or_glob|warn_hours|crit_hours".
# A glob selects the newest match; a plain path is used directly; a missing file
# (or no glob match) is CRIT. Empty array = no custom checks.
FRESHNESS_CHECKS=(
    # "Transcripts backup|/var/log/my-backup.last-success|26|36"
    # "App DB dump|/tank/backups/appdb/app-*.sql.gz|25|36"
)

# ===== Guests =====
# VMIDs to include in the VM table. LXCs are auto-discovered via `pct list`.
VM_IDS=(100 101 102)

# VMs that are *expected* to be stopped (e.g. on-demand Windows VMs) — excluded
# from "should be running" CRIT alerts and from the telegram OK-flag computation.
VM_EXPECTED_STOPPED=(100)

# VMs running Home Assistant OS — use /mnt/data for the disk check (HASS OS layout).
HASS_OS_VM_IDS=(101)

# ===== Service probes (empty = skip) =====
POSTGRES_LXC=""         # e.g. 103 — runs pg_isready inside the LXC
DOCKER_VM=""            # e.g. 104 — main Docker host VM
DOCKER_IN_LXC=""        # e.g. 105 — docker-in-LXC (Frigate etc.)
OLLAMA_LXC=""           # e.g. 106 — LXC that hosts the Ollama process

# Samba shares to verify are advertised by the local smbd. Empty = skip the
# whole Samba check (services, port 445, share list). Names must match the
# section headers in smb.conf, not paths.
SAMBA_SHARES=()         # e.g. (personal media)

# ===== GPU cgroup check =====
# Dynamic-major mismatch detection after kernel/driver upgrades.
# These LXCs should have the current nvidia-uvm / kfd major numbers in their
# lxc.cgroup2.devices.allow lines. Empty = skip the check.
NVIDIA_UVM_LXCS=()       # e.g. (102 105)
AMD_KFD_LXCS=()          # e.g. (106)

# ===== Docker containers =====
# Bash glob patterns of critical container names — down = CRIT. Case patterns.
DOCKER_CRITICAL_PATTERNS=("traefik*" "cloudflared*" "tailscale*")
# Sub-patterns matched WITHIN critical parent names that should NOT count as critical
# (e.g. an authentik-postgresql sidecar is not itself infra-critical):
DOCKER_CRITICAL_EXCLUDE=("*-postgresql*" "*-redis*" "*-db*")
# Container label that silences a container completely: it is still counted and
# listed in the report, but never raises CRIT or WARN whatever state it is in.
# Meant for test and scratch instances that are left stopped on purpose, and it
# travels with the container instead of needing a name added here. Set the label
# in compose with:
#     labels:
#       daily-health.ignore: "true"
DOCKER_IGNORE_LABEL="daily-health.ignore"

# ===== Expected disks =====
# SMART-monitored disks whose absence should raise CRIT. Serial -> description.
# Leave empty to disable missing-disk detection.
declare -gA EXPECTED_DISKS=(
    # ["S12345EXAMPLE"]="Samsung 860 EVO 500GB (boot)"
    # ["WDABC12345"]="WD Red 8TB (tank)"
)

# ===== Ollama release check (optional) =====
OLLAMA_RELEASES_API="https://api.github.com/repos/ollama/ollama/releases/latest"

# --- Remote site over Tailscale (optional) -----------------------------------
# A second site you never physically visit (e.g. family's NAS + Home Assistant).
# Leave REMOTE_SITE_SSH empty to disable the whole check.
# Reachability uses SSH, not ping: Tailscale hybrid networking is not reliably
# pingable. The ssh alias/key live in an unprivileged user's home, so the check
# runs ssh via sudo -u REMOTE_SITE_SSH_USER.
REMOTE_SITE_SSH=""                     # ssh alias, e.g. "family-nas" (empty = disabled)
REMOTE_SITE_LABEL="remote site"        # shown in alerts
REMOTE_SITE_SSH_USER="claude"          # user owning the ssh config/key
REMOTE_SITE_VOLUME="/volume2"          # volume that must stay mounted (holds the VM)
REMOTE_SITE_BACKUP_GLOB=""             # e.g. "/volume1/hass-backup/*/*.tar" (empty = skip)
REMOTE_SITE_BACKUP_MAX_AGE_H=36        # CRIT if the newest backup is older than this
REMOTE_SITE_URL=""                     # e.g. "http://100.x.y.z" — plain up/down signal
REMOTE_SITE_HTTPS_URL=""               # e.g. "https://host.tailnet.ts.net" — WARN only

# --- UniFi (optional; the whole check is skipped unless UNIFI_HOST is set) ---
# Use a READ-ONLY controller account. The check only ever GETs.
# It surfaces three things the controller does not alert on by itself:
#   * an AP whose wired uplink negotiated below UNIFI_UPLINK_MIN_MBPS. A gigabit AP
#     running at 100 Mbps still passes traffic, so nothing complains for days.
#   * a named client whose signal drifted below UNIFI_RSSI_MIN_DBM.
#   * switch-port link flaps since the previous run. Flaps lead, errors lag - and the
#     unpoller Prometheus exporter does NOT export link_down_count, so this is the
#     only place they are visible.
# The session cookie is cached next to the state file: the controller rate-limits the
# login endpoint (HTTP 429) after a few attempts, which repeated testing will trip.
#UNIFI_HOST=192.0.2.10          # controller IP or hostname (RFC 5737 example addr)
#UNIFI_USER=readonly-user
#UNIFI_PASS=changeme
#UNIFI_SITE=default
#UNIFI_UPLINK_MIN_MBPS=1000
# Comma-separated AP names to skip. Wireless-meshed APs are skipped automatically
# (their uplink.type is not "wire"), so they do not need listing here.
#UNIFI_UPLINK_EXCLUDE=
# Comma-separated client names, matched against the controller's name or hostname.
#UNIFI_RSSI_CLIENTS=Doorbell,Garden Cam
#UNIFI_RSSI_MIN_DBM=-75
# Comma-separated port names (or "Switch/portidx") to ignore for flaps. Devices that
# legitimately drop the link - e.g. a PC sleeping with Wake-on-LAN, which parks its
# NIC at 10 Mbps - belong here or they warn every night.
#UNIFI_FLAP_EXCLUDE=P04-DeskPC
#UNIFI_FLAP_WARN_DELTA=1
# Comma-separated port names (or "Switch/portidx") to ignore for the link-SPEED
# regression check. That check warns when a port comes up slower than its own
# best-ever speed, so an absolute floor is not needed - but a port whose device
# deliberately parks the NIC at a lower speed (WoL, power-saving TVs) belongs
# here. The baseline is stored beside the flap state, in <state>.speeds.
#UNIFI_SPEED_EXCLUDE=

# --- dpkg / apt health -------------------------------------------------------
# Days of no package installs, with upgrades pending, before it is treated as a
# stall rather than an idle host. The failure this guards against is silent: a
# wedged dpkg produces no unattended-upgrades log lines, so a check that reads
# that log sees nothing wrong. Lower it on a host you patch weekly.
#DPKG_STALE_DAYS=14

# --- Frigate camera streams + GenAI endpoint (optional) ----------------------
# A camera at 0 fps is invisible to every other check: the container is healthy,
# the host is up, the switch port shows link and PoE. Only Frigate itself knows.
# Leave FRIGATE_API empty to skip the whole check.
#FRIGATE_API=http://192.0.2.20:5000
#FRIGATE_FPS_MIN=1                 # CRIT below this, per camera
# Cameras that are expected to be dark (a 3D printer that is usually powered
# off, a seasonal camera) - otherwise they CRIT every night.
#FRIGATE_CAMERA_EXCLUDE=
# Reachability probe for the GenAI/LLM base_url Frigate is configured to use.
# Object descriptions fail silently when this rots, and it rots independently
# of the streams - a retired inference backend leaves the URL pointing at a
# port nothing listens on any more.
#FRIGATE_GENAI_URL=

# NVIDIA VRAM headroom thresholds (MiB free). The card is shared by several
# tenants that grow independently - local STT, vision embeddings, and one
# decode context per camera plus transcodes - and nothing fails loudly when it
# fills; the next allocation just fails or silently falls back to CPU.
NVIDIA_VRAM_WARN_MIB=1536
NVIDIA_VRAM_CRIT_MIB=512

# --- KasmVNC desktop liveness (optional) -------------------------------------
# An HTTP probe of the KasmVNC port returns 200 even when the desktop is wedged,
# so it cannot detect the real failure. This runs `xset q` against the X display
# inside the container, on DOCKER_VM. Leave KASM_CONTAINER empty to skip.
KASM_CONTAINER=""                  # e.g. kasmweb-chrome
KASM_DISPLAY=":1"

# --- Authentik forward-auth drift (optional) ---------------------------------
# `intercept_header_auth` makes the outpost consume the Authorization header and
# validate it against Authentik itself, which silently breaks any backend doing
# its own header auth (e.g. KasmVNC's websocket) while plain HTTP keeps working.
# It defaults to TRUE and lives only in Authentik's database, so an upgrade or a
# UI edit can reintroduce it. List the provider names that must keep it OFF.
AUTHENTIK_URL=""                   # e.g. https://auth.example.com
AUTHENTIK_TOKEN=""                 # API token, scope=API
AUTHENTIK_NO_HEADER_INTERCEPT=()   # e.g. ("Chrome Forward Auth")
